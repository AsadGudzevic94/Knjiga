# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude AI (get your API key from https://console.anthropic.com)
# Without this key, QuoteCheck uses rule-based analysis only.
# With it, you get rich AI explanations, community insights, and detailed score justification.
ANTHROPIC_API_KEY=sk-ant-...

# Brave Search API (get free key from https://brave.com/search/api/)
# Free tier: 1 query/sec, 1000 queries/month — more than enough for testing.
# With this key, the AI agent actually searches the web for real pricing data,
# Reddit threads, forum posts, and consumer reports. Without it, Claude uses
# its training data (still good, but not live).
BRAVE_SEARCH_API_KEY=BSA...

# Stripe (get keys from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase (get keys from https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
